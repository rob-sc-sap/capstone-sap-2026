{
  "name": "vendor-selection",
  "version": "1.0.0",
  "description": "A simple CAP project.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap-cloud-sdk/resilience": "^4.5.1",
    "@sap/cds": "^9",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@types/node": "^24.0.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve"
  },
  "private": true,
  "cds": {
    "requires": {
      "db": {
        "kind": "hana"
      },
      "GENERATIVE_AI_HUB": {
        "kind": "rest",
        "credentials": {
          "destination": "AI_CORE",
          "requestTimeout": "300000"
        },
        "GPT5_DEPLOYMENT_ID": "da6fb5aa5dddb67e",
        "RPT1_SMALL_DEPLOYMENT_ID": "d59a9f3f253879d9",
        "RESOURCE_GROUP_ID": "default",
        "API_VERSION": "2024-10-21"
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
