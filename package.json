{
  "name": "capstone-sap-2026",
  "version": "1.0.0",
  "description": "SAP CAP vendor selection project with AI Core integration.",
  "dependencies": {
    "@cap-js/hana": "^2",
    "@sap-cloud-sdk/connectivity": "^4.5.1",
    "@sap-cloud-sdk/http-client": "^4.5.1",
    "@sap-cloud-sdk/resilience": "^4.5.1",
    "@sap/cds": "^9",
    "express": "^4",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/cds-typer": ">=0.1",
    "@cap-js/cds-types": "^0.15.0",
    "@cap-js/sqlite": "^2",
    "@sap/cds-dk": "^9",
    "@types/node": "^24.0.0",
    "cds-plugin-ui5": "^0.13.0",
    "tsx": "^4",
    "typescript": "^5"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-project1": "cds watch --open project1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-products1": "cds watch --open products1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-purchaseorders1": "cds watch --open purchaseorders1/index.html?sap-ui-xx-viewCache=false --livereload false",
    "watch-kpiprofile1": "cds watch --open kpiprofile1/index.html?sap-ui-xx-viewCache=false --livereload false"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/project1",
    "app/products1",
    "app/purchaseorders1",
    "app/kpiprofile1"
  ],
  "cds": {
    "requires": {
      "db": {
        "[production]": {
          "kind": "hana"
        },
        "[default]": {
          "kind": "sqlite"
        }
      },
      "GENERATIVE_AI_HUB": {
        "kind": "rest",
        "credentials": {
          "destination": "AI_CORE",
          "requestTimeout": "300000"
        },
        "GPT5_DEPLOYMENT_ID": "da6fb5aa5dddb67e",
        "RPT1_SMALL_DEPLOYMENT_ID": "d59a9f3f253879d9",
        "RESOURCE_GROUP_ID": "default",
        "API_VERSION": "2024-10-21"
      },
      "[production]": {
        "auth": "xsuaa"
      }
    }
  },
  "imports": {
    "#cds-models/*": "./@cds-models/*/index.js"
  }
}
